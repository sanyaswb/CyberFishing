{
  "schemaVersion": 1,
  "kind": "cyber-fishing-root-package-contract",
  "package": {
    "name": "cyber-fishing",
    "versionSource": "src/config/project_version.js",
    "private": true,
    "moduleTypePolicy": "root-type-field-absent-commonjs-tooling-preserved"
  },
  "runtime": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10.8.2",
    "packageManager": "npm@11.6.2"
  },
  "lockfile": {
    "path": "package-lock.json",
    "format": "npm",
    "lockfileVersion": 3,
    "installCommand": "npm ci",
    "requiresIntegrity": true,
    "gitPolicy": "required-not-ignored"
  },
  "dependencyPolicy": {
    "packageJsonRangesAuthoritative": true,
    "lockfileResolutionsAuthoritative": true,
    "directSections": [
      "dependencies",
      "devDependencies"
    ]
  },
  "stage": {
    "current": "3.4",
    "vite": "fixture-bridge-and-cumulative-runtime-infrastructure",
    "productionEntrypoint": "unchanged-index-html",
    "sourceRuntime": "classic-scripts-with-cumulative-iife-runtime",
    "commonJsTooling": "preserved",
    "bridgeBuild": {
      "status": "transitioned-to-cumulative-runtime",
      "registry": "architecture/guards/migration_bridge_registry.json",
      "inputs": "stage-2-bridges-exposed-through-stage-3-cumulative-runtime",
      "output": "dist/legacy-bridges/",
      "runtimeInputs": 0
    },
    "cumulativeRuntimeBuild": {
      "status": "runtime-integration-active",
      "contract": "architecture/migration/stage_3_compatibility_runtime.json",
      "executionState": "architecture/migration/stage_3_execution_state.json",
      "output": "dist/stage-3-compat-runtime/",
      "runtimeInputs": 13,
      "activationInputs": 13
    }
  }
}
