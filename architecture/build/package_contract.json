{
  "schemaVersion": 1,
  "kind": "cyber-fishing-root-package-contract",
  "package": {
    "name": "cyber-fishing",
    "versionSource": "src/config/project_version.js",
    "private": true,
    "moduleTypePolicy": "root-type-field-absent-commonjs-tooling-preserved"
  },
  "runtime": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10.8.2",
    "packageManager": "npm@11.6.2"
  },
  "lockfile": {
    "path": "package-lock.json",
    "format": "npm",
    "lockfileVersion": 3,
    "installCommand": "npm ci",
    "requiresIntegrity": true,
    "gitPolicy": "required-not-ignored"
  },
  "dependencyPolicy": {
    "packageJsonRangesAuthoritative": true,
    "lockfileResolutionsAuthoritative": true,
    "directSections": [
      "dependencies",
      "devDependencies"
    ]
  },
  "stage": {
    "current": "2.0",
    "vite": "fixture-and-approved-bridge-build-infrastructure",
    "productionEntrypoint": "unchanged-index-html",
    "sourceRuntime": "classic-scripts-unchanged",
    "commonJsTooling": "preserved",
    "bridgeBuild": {
      "status": "foundation-verified",
      "registry": "architecture/guards/migration_bridge_registry.json",
      "inputs": "approved-active-wrappers-only",
      "output": "dist/legacy-bridges/",
      "runtimeInputs": 0
    }
  }
}
